# HandsFree — LLM config (pick one, all OpenAI-compatible + Gemini via AI Studio)
# No key = fallback heuristic (still index-based, no invented targets)

# --- explicit provider (optional) ---
# LLM_PROVIDER=aistudio   # openrouter | aistudio | deepseek | openai | generic
# LLM_MODEL=gemini-2.5-flash
# LLM_BASE_URL=https://api.example.com/v1
# LLM_API_KEY=

# --- DeepSeek (https://platform.deepseek.com) ---
DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- OpenAI (https://platform.openai.com) ---
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- OpenRouter — one key for 200+ models (https://openrouter.ai) ---
# Works with: google/gemini-2.5-flash-exp:free, anthropic/claude-3.5-sonnet, openai/gpt-4o, etc.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=google/gemini-2.5-flash-exp:free
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Google AI Studio — free Gemini (https://aistudio.google.com) ---
# Get key at https://aistudio.google.com/app/apikey — free tier, no billing
AISTUDIO_API_KEY=
# GOOGLE_API_KEY=            # alias for AISTUDIO_API_KEY
# GEMINI_API_KEY=            # alias for AISTUDIO_API_KEY
# GEMINI_MODEL=gemini-2.5-flash   # gemini-2.5-flash | gemini-2.5-flash | gemini-1.5-pro

# --- generic OpenAI-compatible (LM Studio, vLLM, etc.) ---
# LLM_API_KEY=
# LLM_BASE_URL=http://localhost:1234/v1
# LLM_MODEL=local-model

PORT=3000
TEST_URL=https://the-internet.herokuapp.com/login
HEADLESS=false
